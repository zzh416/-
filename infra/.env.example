# ===== 面经综合助手 环境变量模板 =====
# 复制为 .env 后按需填写：cp .env.example .env

# 资料日期和近期统计采用此时区；系统时间戳仍以 UTC 保存。
APP_TIMEZONE=Asia/Shanghai

# --- 基础镜像源（国内无法直连 Docker Hub 时，取消注释改用镜像加速）---
# API_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# WEB_BASE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
# RENDERER_BASE_IMAGE=mcr.m.daocloud.io/playwright:v1.64.0-noble

# --- 数据库（PostgreSQL + pgvector）---
POSTGRES_DB=bagu
POSTGRES_USER=bagu
POSTGRES_PASSWORD=bagu_dev_password

# --- 前端代理目标（Docker 内为 api 服务名；宿主机直跑可留空，默认 localhost:9000）---
VITE_PROXY_TARGET=http://api:9000

# --- 公开动态网页渲染 ---
# 单页最大等待秒数；登录、验证码和整站爬取不在当前范围内。
RENDERER_TIMEOUT_SECONDS=30

# --- AI 与图片识别（基础文字、文档和网页导入无需填写）---
# 文字题答 / 简历画像可选 glm 或 deepseek；显式选择，不自动降级。
# 图片、扫描 PDF 和 Word 内嵌图片 OCR 同样可选 glm 或 deepseek，与文字模型相互独立。
TEXT_MODEL_PROVIDER=glm
OCR_PROVIDER=glm
# 模型网关：智谱 GLM（默认文本 / OCR）
# 申请地址：https://open.bigmodel.cn/
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TEXT_MODEL=glm-4-plus
GLM_OCR_MODEL=glm-ocr

# --- 模型网关：DeepSeek（文字或 OCR 选择 deepseek 时使用）---
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-chat
DEEPSEEK_OCR_MODEL=deepseek-flash
# 本项目单次图片转录输出上限，允许 1～65536；输出被截断时会提示失败。
DEEPSEEK_OCR_MAX_OUTPUT_TOKENS=8192

# --- 按需单题 AI 补充答案（沿用 TEXT_MODEL_PROVIDER）---
# 每位用户每天的显式生成/重试次数、同时处理数及单任务手动重试上限。
AI_ANSWER_DAILY_LIMIT=30
AI_ANSWER_CONCURRENCY_LIMIT=1
AI_ANSWER_RETRY_LIMIT=3

# --- Embedding：SiliconFlow BGE-M3 ---
# 申请地址：https://siliconflow.cn/
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
